    "arr = [-1, -2, 3, 4, -5, 6]\n",
    "count = 0 \n",
    "for i in arr:\n",
    "    if i<0:\n",
    "        count +=1\n",
    "print(f\"Total negative numbers found: {count}\")"
   ]
