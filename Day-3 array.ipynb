   "source": [
    "# Move all zeroes to the end\n",
    "arr =[8,0,9,0,4,3,0,9,8,0,1,0,2]\n",
    "count = 0\n",
    "for i in range(len(arr)):\n",
    "    if arr[i] != 0:\n",
    "        arr[count] = arr[i]\n",
    "        count += 1\n",
    "for i in range(count, len(arr)):\n",
    "    arr[i] = 0\n",
    "print(arr)"
   ]
  }
